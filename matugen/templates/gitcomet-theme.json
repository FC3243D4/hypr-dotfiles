{
  "schema_version": 2,
  "name": "Matugen Standard Gray Theme",
  "author": "Matugen",
  "themes": [
    {
      "key": "matugen_standard_gray_dark",
      "name": "Matugen Standard Gray Dark",
      "appearance": "dark",
      "colors": {
        "surface": {
          "canvas": "{{ palettes.neutral._10.hex }}",
          "chrome": "{{ palettes.neutral._15.hex }}",
          "panel": "{{ palettes.neutral._15.hex }}",
          "raised": "{{ palettes.neutral._20.hex }}",
          "input": "{{ palettes.neutral._25.hex }}"
        },
        "foreground": {
          "primary": "{{ colors.on_surface.default.hex }}",
          "secondary": "{{ colors.on_surface_variant.default.hex }}",
          "disabled": { "hex": "{{ colors.on_surface_variant.default.hex }}", "alpha": 0.62 },
          "placeholder": "#ffffff59",
          "emphasis": "{{ colors.on_surface.default.hex }}"
        },
        "stroke": {
          "subtle": "#ffffff14",
          "default": "{{ palettes.neutral_variant._30.hex }}",
          "control": "{{ palettes.neutral_variant._50.hex }}"
        },
        "interaction": {
          "hover_overlay": { "hex": "{{ colors.on_surface.default.hex }}", "alpha": 0.07 },
          "pressed_overlay": { "hex": "{{ colors.on_surface.default.hex }}", "alpha": 0.11 },
          "hover_background": "{{ palettes.neutral._25.hex }}",
          "pressed_background": "{{ palettes.neutral._35.hex }}",
          "selected_background": "{{ palettes.neutral._20.hex }}",
          "selected_foreground": "{{ colors.on_surface.default.hex }}",
          "selected_indicator": "{{ colors.primary.default.hex }}",
          "focus_ring": "{{ colors.primary.default.hex }}",
          "focus_background": { "hex": "{{ colors.primary.default.hex }}", "alpha": 0.16 }
        },
        "accent": {
          "foreground": "{{ colors.primary.default.hex }}",
          "solid": "{{ colors.primary.default.hex }}",
          "on_solid": "{{ colors.on_primary.default.hex }}",
          "subtle_background": "{{ palettes.primary._20.hex }}"
        },
        "status": {
          "info": {
            "foreground": "{{ colors.primary.default.hex }}",
            "background": "{{ palettes.primary._20.hex }}",
            "border": "{{ colors.primary.default.hex }}"
          },
          "success": {
            "foreground": "{{ colors.diff_added.default.hex }}",
            "background": "{{ colors.diff_added_container.default.hex }}",
            "border": "{{ colors.diff_added.default.hex }}"
          },
          "warning": {
            "foreground": "{{ colors.diff_modified.default.hex }}",
            "background": "{{ colors.diff_modified_container.default.hex }}",
            "border": "{{ colors.diff_modified.default.hex }}"
          },
          "danger": {
            "foreground": "{{ colors.diff_removed.default.hex }}",
            "background": "{{ colors.diff_removed_container.default.hex }}",
            "border": "{{ colors.diff_removed.default.hex }}"
          }
        },
        "editor": {
          "background": "{{ palettes.neutral._10.hex }}",
          "foreground": "{{ colors.on_surface.default.hex }}",
          "gutter_background": "{{ palettes.neutral._10.hex }}",
          "line_number": "{{ colors.on_surface_variant.default.hex }}",
          "cursor": "{{ colors.on_surface.default.hex }}",
          "selection_background": "{{ palettes.primary._30.hex }}",
          "search_match_background": "{{ palettes.tertiary._30.hex }}",
          "search_match_foreground": "{{ colors.tertiary.default.hex }}",
          "bracket_match_background": "#ffffff26",
          "occurrence_highlight_background": "{{ colors.primary.default.hex_alpha | set_alpha: 0.20 }}",
          "indent_guide": "#ffffff14"
        },
        "diff": {
          "added": {
            "foreground": "{{ colors.diff_added.default.hex }}",
            "background": "{{ colors.diff_added_container.default.hex_alpha | set_alpha: 0.35 }}",
            "word_background": "{{ colors.diff_added.default.hex_alpha | set_alpha: 0.22 }}",
            "focused_background": "{{ colors.diff_added.default.hex_alpha | set_alpha: 0.20 }}"
          },
          "removed": {
            "foreground": "{{ colors.diff_removed.default.hex }}",
            "background": "{{ colors.diff_removed_container.default.hex_alpha | set_alpha: 0.35 }}",
            "word_background": "{{ colors.diff_removed.default.hex_alpha | set_alpha: 0.22 }}",
            "focused_background": "{{ colors.diff_removed.default.hex_alpha | set_alpha: 0.20 }}"
          },
          "modified": {
            "foreground": "{{ colors.diff_modified.default.hex }}",
            "background": "{{ colors.diff_modified_container.default.hex_alpha | set_alpha: 0.35 }}",
            "word_background": "{{ colors.diff_modified.default.hex_alpha | set_alpha: 0.22 }}",
            "focused_background": "{{ colors.diff_modified.default.hex_alpha | set_alpha: 0.20 }}"
          }
        },
        "tooltip": {
          "background": "{{ palettes.neutral._10.hex }}",
          "foreground": "{{ colors.on_surface.default.hex }}"
        },
        "scrollbar": {
          "thumb": { "hex": "{{ colors.on_surface_variant.default.hex }}", "alpha": 0.30 },
          "thumb_hover": { "hex": "{{ colors.on_surface_variant.default.hex }}", "alpha": 0.42 },
          "thumb_pressed": { "hex": "{{ colors.on_surface_variant.default.hex }}", "alpha": 0.52 }
        },
        "notice": {
          "background": { "hex": "{{ colors.primary.default.hex }}", "alpha": 0.13 },
          "border": { "hex": "{{ colors.primary.default.hex }}", "alpha": 0.30 },
          "foreground": "{{ colors.on_surface.default.hex }}",
          "secondary": "{{ colors.on_surface_variant.default.hex }}"
        },
        "interstitial": {
          "text": "{{ colors.on_surface.default.hex }}",
          "muted": "{{ colors.on_surface_variant.default.hex }}",
          "primary": {
            "text": "{{ colors.on_primary.default.hex }}",
            "background": "{{ colors.primary.default.hex }}",
            "background_hover": "{{ palettes.primary._90.hex }}",
            "background_active": "{{ palettes.primary._70.hex }}",
            "border": "{{ colors.primary.default.hex }}",
            "border_hover": "{{ palettes.primary._90.hex }}",
            "border_active": "{{ palettes.primary._70.hex }}"
          },
          "secondary": {
            "text": "{{ colors.on_surface.default.hex }}",
            "background": "#ffffff26",
            "background_hover": "#ffffff33",
            "background_active": "#ffffff40",
            "border": "#ffffff47",
            "border_hover": "#ffffff66",
            "border_active": "#ffffff80"
          }
        },
        "shadow": "#000000ff",
        "graph_lane_palette": [
          "{{ colors.primary.default.hex }}",
          "{{ colors.secondary.default.hex }}",
          "{{ colors.tertiary.default.hex }}",
          "{{ colors.error.default.hex }}",
          "{{ palettes.primary._60.hex }}",
          "{{ palettes.secondary._60.hex }}",
          "{{ palettes.tertiary._60.hex }}",
          "{{ palettes.primary._80.hex }}",
          "{{ palettes.secondary._80.hex }}",
          "{{ palettes.tertiary._80.hex }}",
          "{{ palettes.primary._40.hex }}",
          "{{ palettes.secondary._40.hex }}",
          "{{ palettes.tertiary._40.hex }}"
        ]
      },
      "syntax": {
        "diff_plus": "{{ colors.diff_added.default.hex }}",
        "diff_minus": "{{ colors.diff_removed.default.hex }}",
        "diff_delta": "{{ colors.diff_modified.default.hex }}"
      },
      "radii": {
        "panel": 12.0,
        "pill": 999.0,
        "row": 8.0,
        "control": 8.0,
        "popover": 10.0,
        "window": 12.0
      }
    }
  ]
}